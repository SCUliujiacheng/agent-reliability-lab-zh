# 仅作为配置参考，应用不会自动加载本文件。
# 请在进程环境中导出这些值，或修改 compose.yaml 中的 Docker Compose 配置。

ARL_DATA_DIR=data
ARL_DATABASE_PATH=agent-reliability-lab.db
ARL_SCENARIO_DIR=scenarios/incident-response
ARL_EVALUATION_SUITE=incident-response
ARL_EVALUATION_SUITE_DIR=scenarios/incident-response

# 以逗号分隔的精确来源。留空时保持同源默认值。
ARL_CORS_ORIGINS=

# 替换精确的 API Host 允许列表。通配符、协议、端口和空条目均无效。
# 请保持该配置与 web/nginx.conf 中的 server_name 值一致。
ARL_TRUSTED_HOSTS=localhost,127.0.0.1,api

# 有效范围：1..1048576 字节。
ARL_MAX_REQUEST_BODY_BYTES=65536

# 每次运行可持久化预留的新策略调用次数。有效范围：1..1024。
# 工具重试和重建的待审批动作不会额外预留名额。
ARL_MAX_ACTION_STEPS=64

# 以逗号分隔、需要脱敏的字面值。切勿在此提交真实凭证。
ARL_SECRET_VALUES=
